<% if (page.prev_link || page.next_link) { %>
  <nav class="pagination" aria-label="Pagination">
    <% if (page.prev_link) { %><a href="<%- url_for(page.prev_link) %>">← Newer</a><% } else { %><span></span><% } %>
    <span><%= page.current %> / <%= page.total %></span>
    <% if (page.next_link) { %><a href="<%- url_for(page.next_link) %>">Older →</a><% } else { %><span></span><% } %>
  </nav>
<% } %>
